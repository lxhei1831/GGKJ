/**app.wxss**/
page {
  min-height: 100vh;
  background: #f8fafc;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.page-shell {
  min-height: 100vh;
  display: block;
  background:
    radial-gradient(circle at 78% 8%, rgba(251, 146, 60, 0.14) 0%, rgba(251, 146, 60, 0) 30%),
    radial-gradient(circle at 4% 12%, rgba(191, 219, 254, 0.44) 0%, rgba(191, 219, 254, 0) 34%),
    linear-gradient(135deg, #ffffff 0%, #eef7ff 54%, #fff8ed 100%);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page-content {
  padding: 24rpx 28rpx 160rpx;
  box-sizing: border-box;
}

.hero-panel {
  padding: 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 62%, #fff7ed 100%);
  color: #0f172a;
  border: 1rpx solid rgba(148, 163, 184, 0.26);
  box-shadow: 0 12rpx 30rpx rgba(37, 99, 235, 0.08);
}

.hero-top,
.section-head,
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.eyebrow,
.hero-panel .eyebrow {
  font-size: 22rpx;
  color: #2563eb;
  font-weight: 800;
}

.hero-title {
  display: block;
  margin-top: 14rpx;
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 900;
  letter-spacing: 0;
  color: #0f172a;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: #475569;
}

.section {
  margin-top: 28rpx;
}

.section-title {
  font-size: 30rpx;
  line-height: 1.3;
  color: #0f172a;
  font-weight: 900;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #64748b;
}

.card {
  margin-top: 18rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f8fbff 66%, #fff7ed 100%);
  border: 1rpx solid rgba(148, 163, 184, 0.26);
  box-shadow: 0 12rpx 30rpx rgba(37, 99, 235, 0.08);
  box-sizing: border-box;
}

.grid-two {
  display: flex;
  flex-wrap: wrap;
  margin: 4rpx -8rpx 0;
}

.grid-item {
  width: 50%;
  padding: 8rpx;
  box-sizing: border-box;
}

.grid-item-full {
  width: 100%;
}

.card-title {
  display: block;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 850;
  color: #0f172a;
}

.card-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #64748b;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  font-size: 38rpx;
  line-height: 1.15;
  font-weight: 900;
  color: #0f172a;
}

.metric-label {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1;
  font-weight: 700;
}

.badge-high {
  color: #c2410c;
  background: #ffedd5;
}

.badge-medium {
  color: #9a3412;
  background: #fff7ed;
}

.badge-low {
  color: #1d4ed8;
  background: #eff6ff;
}

.badge-info {
  color: #1d4ed8;
  background: #eff6ff;
}

.primary-button,
.secondary-button,
.ghost-button {
  height: 82rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 750;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  color: #ffffff;
  background: #3b82f6;
  box-shadow: 0 18rpx 45rpx rgba(59, 130, 246, 0.18);
}

.secondary-button {
  color: #0f172a;
  background: #ffffff;
  border: 1rpx solid rgba(148, 163, 184, 0.32);
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.06);
}

.ghost-button {
  color: #334155;
  background: #f1f5f9;
  border: 1rpx solid rgba(148, 163, 184, 0.22);
}

.input-card {
  margin-top: 18rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f8fbff 66%, #fff7ed 100%);
  border: 1rpx solid rgba(148, 163, 184, 0.26);
  box-shadow: 0 12rpx 30rpx rgba(37, 99, 235, 0.08);
}

.field {
  margin-top: 22rpx;
}

.field:first-child {
  margin-top: 0;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #334155;
  font-weight: 700;
}

.text-input,
.text-area,
.picker-field {
  width: 100%;
  min-height: 80rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 1rpx solid #dbe3ef;
  color: #0f172a;
  font-size: 26rpx;
  box-sizing: border-box;
}

.text-area {
  min-height: 180rpx;
  line-height: 1.5;
}

.list-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e5eaf3;
}

.list-row:last-child {
  border-bottom: 0;
}

.muted {
  color: #64748b;
}

.divider {
  height: 1rpx;
  background: #e5eaf3;
  margin: 22rpx 0;
}
