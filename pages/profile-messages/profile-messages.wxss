page {
  min-height: 100vh;
}

.profile-feature-page {
  padding-bottom: 72rpx;
}

.feature-hero-messages {
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 58%, #fff7ed 100%);
}

.empty-panel {
  padding: 34rpx 28rpx;
  border-radius: 28rpx;
  text-align: center;
  background: linear-gradient(145deg, #ffffff 0%, #f8fbff 66%, #fff7ed 100%);
  border: 1rpx solid rgba(148, 163, 184, 0.26);
  box-shadow: 0 12rpx 30rpx rgba(37, 99, 235, 0.08);
}

.empty-mark {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0 auto;
  border-radius: 18rpx;
  display: block;
  color: #ffffff;
  background: linear-gradient(145deg, #3b82f6 0%, #2563eb 62%, #fb923c 100%);
  font-size: 32rpx;
  font-weight: 900;
}

.empty-title {
  display: block;
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 850;
  color: #111827;
}

.empty-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #64748b;
}

.message-card {
  margin-top: 18rpx;
}

.timeline-card {
  padding-top: 4rpx;
  padding-bottom: 4rpx;
}

.timeline-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef2f6;
}

.timeline-row:last-child {
  border-bottom: 0;
}

.timeline-node {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 850;
  color: #ffffff;
  background: #3b82f6;
  flex: none;
}

.timeline-main {
  margin-left: 18rpx;
}
