<view class="page-shell">
  <view class="page-content tools-page">
    <view class="hero-panel tools-hero">
      <text class="eyebrow">申诉与维权闭环</text>
      <text class="hero-title">被投诉、盗图和申诉材料快速建档</text>
      <text class="hero-desc">围绕平台申诉、投诉材料和英文信函做工具化入口。</text>
    </view>

    <view class="section">
      <text class="section-title">平台投诉模板</text>
      <view class="card">
        <view class="template-row" wx:for="{{platformTemplates}}" wx:key="platform">
          <view>
            <text class="card-title">{{item.platform}}</text>
            <text class="card-desc">{{item.desc}}</text>
          </view>
          <view class="secondary-button mini-button" bindtap="openTemplateGenerator" data-platform="{{item.platform}}">生成</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="card assistant-card">
        <view>
          <text class="card-title">港港跨境 AI 助手</text>
          <text class="card-desc">把平台通知、申诉材料、商品图和证据文件发给 AI，直接进入对话处理。</text>
        </view>
        <view class="primary-button assistant-button" bindtap="openAiAssistant">开始聊天</view>
      </view>
    </view>
  </view>
</view>
