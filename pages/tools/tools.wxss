page {
  min-height: 100vh;
}

.tools-page {
  padding-bottom: 72rpx;
}

.tools-hero {
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 58%, #fff7ed 100%);
}

.template-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef2f6;
}

.template-row:last-child {
  border-bottom: 0;
}

.mini-button {
  width: 132rpx;
  height: 66rpx;
  margin-left: 20rpx;
  flex: none;
  font-size: 24rpx;
}

.assistant-card {
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 58%, #fff7ed 100%);
}

.assistant-button {
  margin-top: 22rpx;
}
