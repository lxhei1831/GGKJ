page {
  min-height: 100vh;
}

.detect-page {
  padding-bottom: 72rpx;
}

.detect-hero {
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 58%, #fff7ed 100%);
}

.mode-board {
  display: flex;
  flex-wrap: wrap;
  margin: 10rpx -8rpx 0;
}

.mode-card {
  width: calc(50% - 16rpx);
  min-height: 166rpx;
  margin: 8rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f8fbff 66%, #fff7ed 100%);
  border: 1rpx solid rgba(148, 163, 184, 0.26);
  box-shadow: 0 12rpx 30rpx rgba(37, 99, 235, 0.08);
  box-sizing: border-box;
}

.mode-card-active {
  border-color: rgba(59, 130, 246, 0.42);
  background: linear-gradient(145deg, #ffffff 0%, #eff6ff 58%, #fff7ed 100%);
  box-shadow: 0 16rpx 36rpx rgba(59, 130, 246, 0.16);
}

.mode-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.mode-mark {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  border-radius: 18rpx;
  text-align: center;
  font-size: 23rpx;
  font-weight: 850;
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid #dbeafe;
}

.mode-state {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #1d4ed8;
  background: #dbeafe;
}

.mode-label {
  display: block;
  font-size: 27rpx;
  font-weight: 800;
  color: #111827;
}

.mode-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.35;
  color: #64748b;
}

.selector-grid {
  display: flex;
  margin: 0 -8rpx;
}

.selector-item {
  width: 50%;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.upload-panel {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  border: 1rpx dashed rgba(59, 130, 246, 0.32);
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 58%, #fff7ed 100%);
  box-shadow: 0 12rpx 30rpx rgba(37, 99, 235, 0.08);
}

.upload-title {
  display: block;
  font-size: 27rpx;
  font-weight: 800;
  color: #111827;
}

.upload-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #64748b;
}

.large-area {
  min-height: 260rpx;
}

.button-row {
  display: flex;
  margin: 24rpx -8rpx 0;
}

.button-half {
  flex: 1;
  margin: 0 8rpx;
}

.result-card {
  overflow: hidden;
}

.result-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.result-score {
  display: block;
  font-size: 70rpx;
  line-height: 1;
  font-weight: 900;
  color: #2563eb;
}

.result-level {
  text-align: right;
}

.risk-block {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f8fbff 66%, #fff7ed 100%);
  border: 1rpx solid rgba(148, 163, 184, 0.26);
  box-shadow: 0 12rpx 30rpx rgba(37, 99, 235, 0.08);
}

.risk-block-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #111827;
}

.pdf-report-action {
  margin-top: 22rpx;
}

.report-button {
  height: 76rpx;
}

.pdf-missing-text {
  display: block;
  margin-top: 16rpx;
}

.trademark-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef2f6;
}

.trademark-row:last-child {
  border-bottom: 0;
}

.trademark-title {
  display: block;
  max-width: 440rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #111827;
  word-break: break-word;
}

.suggestion-row {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
}

.suggestion-index {
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 21rpx;
  font-weight: 800;
  color: #ffffff;
  background: #3b82f6;
  flex: none;
}

.suggestion-text {
  margin-left: 16rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #334155;
}

.report-history-card {
  padding-top: 0;
  padding-bottom: 0;
}

.report-history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef2f6;
}

.report-history-main {
  flex: 1;
  min-width: 0;
}

.report-history-side {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  flex: none;
}

.report-pdf-button,
.report-pdf-missing {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.report-pdf-button {
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid rgba(37, 99, 235, 0.18);
}

.report-pdf-missing {
  color: #92400e;
  background: #fef3c7;
  border: 1rpx solid rgba(180, 83, 9, 0.18);
}

.report-delete-button {
  margin-left: 12rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(220, 38, 38, 0.18);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  color: #b91c1c;
  background: #fee2e2;
}

.menu-arrow {
  margin-left: 12rpx;
  font-size: 36rpx;
  color: #98a2b3;
}

.report-history-row:last-child {
  border-bottom: 0;
}

.report-list-action {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  border-top: 1rpx solid #eef2f6;
}

.report-list-text {
  font-size: 25rpx;
  font-weight: 800;
  color: #2563eb;
}

.report-empty {
  padding: 24rpx 0;
}
