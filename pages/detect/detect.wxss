page {
  min-height: 100vh;
}

.detect-page {
  padding-bottom: 72rpx;
}

.detect-hero {
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 58%, #fff7ed 100%);
}

.mode-board {
  display: flex;
  flex-wrap: wrap;
  margin: 10rpx -8rpx 0;
}

.mode-card {
  width: calc(50% - 16rpx);
  min-height: 166rpx;
  margin: 8rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f8fbff 66%, #fff7ed 100%);
  border: 1rpx solid rgba(148, 163, 184, 0.26);
  box-shadow: 0 12rpx 30rpx rgba(37, 99, 235, 0.08);
  box-sizing: border-box;
}

.mode-card-active {
  border-color: rgba(59, 130, 246, 0.42);
  background: linear-gradient(145deg, #ffffff 0%, #eff6ff 58%, #fff7ed 100%);
  box-shadow: 0 16rpx 36rpx rgba(59, 130, 246, 0.16);
}

.mode-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.mode-mark {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  border-radius: 18rpx;
  text-align: center;
  font-size: 23rpx;
  font-weight: 850;
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid #dbeafe;
}

.mode-state {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #1d4ed8;
  background: #dbeafe;
}

.mode-label {
  display: block;
  font-size: 27rpx;
  font-weight: 800;
  color: #111827;
}

.mode-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.35;
  color: #64748b;
}

.selector-grid {
  display: flex;
  margin: 0 -8rpx;
}

.selector-item {
  width: 50%;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.country-picker-field {
  display: flex;
  align-items: center;
  position: relative;
  min-height: 82rpx;
  padding: 14rpx 18rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8fbff 58%, #fff7ed 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.86), 0 10rpx 24rpx rgba(37, 99, 235, 0.08);
}

.flag-art {
  width: 56rpx;
  height: 38rpx;
  margin-right: 14rpx;
  border-radius: 10rpx;
  background: #ffffff;
  border: 1rpx solid rgba(148, 163, 184, 0.2);
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.08);
  overflow: hidden;
  flex: none;
}

.flag-art-us {
  background: linear-gradient(135deg, #1d4ed8 0%, #1d4ed8 36%, transparent 36%),
    linear-gradient(180deg, #b91c1c 0%, #b91c1c 14%, #ffffff 14%, #ffffff 28%, #b91c1c 28%, #b91c1c 42%, #ffffff 42%, #ffffff 56%, #b91c1c 56%, #b91c1c 70%, #ffffff 70%, #ffffff 84%, #b91c1c 84%, #b91c1c 100%);
}

.flag-art-eu {
  background: radial-gradient(circle at 50% 50%, #facc15 0%, #facc15 18%, transparent 19%),
    #1d4ed8;
}

.flag-art-uk {
  background: linear-gradient(35deg, transparent 0%, transparent 42%, #ffffff 42%, #ffffff 49%, #dc2626 49%, #dc2626 55%, #ffffff 55%, #ffffff 62%, transparent 62%),
    linear-gradient(145deg, transparent 0%, transparent 42%, #ffffff 42%, #ffffff 49%, #dc2626 49%, #dc2626 55%, #ffffff 55%, #ffffff 62%, transparent 62%),
    linear-gradient(90deg, transparent 0%, transparent 40%, #ffffff 40%, #ffffff 46%, #dc2626 46%, #dc2626 54%, #ffffff 54%, #ffffff 60%, transparent 60%),
    linear-gradient(180deg, transparent 0%, transparent 36%, #ffffff 36%, #ffffff 44%, #dc2626 44%, #dc2626 56%, #ffffff 56%, #ffffff 64%, transparent 64%),
    #1e3a8a;
}

.flag-art-ca {
  background: linear-gradient(90deg, #dc2626 0%, #dc2626 27%, #ffffff 27%, #ffffff 73%, #dc2626 73%, #dc2626 100%);
}

.flag-art-au {
  background: radial-gradient(circle at 74% 36%, #ffffff 0%, #ffffff 9%, transparent 10%),
    radial-gradient(circle at 68% 70%, #ffffff 0%, #ffffff 6%, transparent 7%),
    linear-gradient(135deg, #dc2626 0%, #dc2626 18%, #ffffff 18%, #ffffff 24%, transparent 24%),
    #1e3a8a;
}

.flag-art-jp {
  background: radial-gradient(circle at 50% 50%, #dc2626 0%, #dc2626 28%, transparent 29%),
    #ffffff;
}

.flag-art-kr {
  background: radial-gradient(circle at 50% 50%, #dc2626 0%, #dc2626 22%, #2563eb 23%, #2563eb 34%, transparent 35%),
    #ffffff;
}

.flag-art-sea {
  background: radial-gradient(circle at 50% 50%, #facc15 0%, #facc15 18%, transparent 19%),
    linear-gradient(90deg, #2563eb 0%, #2563eb 50%, #dc2626 50%, #dc2626 100%);
}

.flag-art-hk {
  background: radial-gradient(circle at 50% 50%, #ffffff 0%, #ffffff 16%, transparent 17%),
    linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
}

.flag-art-global {
  background: radial-gradient(circle at 50% 50%, #ffffff 0%, #ffffff 18%, transparent 19%),
    linear-gradient(135deg, #0ea5e9 0%, #2563eb 100%);
}

.country-name {
  flex: 1;
  font-size: 26rpx;
  font-weight: 800;
  color: #0f172a;
}

.country-chevron {
  margin-left: 10rpx;
  font-size: 26rpx;
  color: #94a3b8;
}

.country-selector-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(15, 23, 42, 0.18);
}

.country-selector-panel {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  top: 18vh;
  z-index: 21;
  padding: 22rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f8fbff 64%, #fff7ed 100%);
  box-shadow: 0 28rpx 70rpx rgba(15, 23, 42, 0.22);
  border: 1rpx solid rgba(148, 163, 184, 0.24);
}

.country-selector-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.country-selector-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #0f172a;
}

.country-selector-close {
  width: 46rpx;
  height: 46rpx;
  line-height: 42rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 36rpx;
  color: #64748b;
  background: #f1f5f9;
}

.country-option {
  display: flex;
  align-items: center;
  min-height: 78rpx;
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border-radius: 22rpx;
  border: 1rpx solid transparent;
  background: rgba(255, 255, 255, 0.74);
  box-sizing: border-box;
}

.country-option-active {
  border-color: rgba(37, 99, 235, 0.24);
  background: #eff6ff;
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.1);
}

.country-option-name {
  flex: 1;
  font-size: 26rpx;
  font-weight: 800;
  color: #111827;
}

.country-option-check {
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 900;
  color: #ffffff;
  background: #2563eb;
}

.upload-panel {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  border: 1rpx dashed rgba(59, 130, 246, 0.32);
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 58%, #fff7ed 100%);
  box-shadow: 0 12rpx 30rpx rgba(37, 99, 235, 0.08);
}

.upload-title {
  display: block;
  font-size: 27rpx;
  font-weight: 800;
  color: #111827;
}

.upload-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #64748b;
}

.large-area {
  min-height: 260rpx;
}

.button-row {
  display: flex;
  margin: 24rpx -8rpx 0;
}

.button-half {
  flex: 1;
  margin: 0 8rpx;
}

.result-card {
  overflow: hidden;
}

.result-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.result-score {
  display: block;
  font-size: 70rpx;
  line-height: 1;
  font-weight: 900;
  color: #2563eb;
}

.result-level {
  text-align: right;
}

.risk-block {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f8fbff 66%, #fff7ed 100%);
  border: 1rpx solid rgba(148, 163, 184, 0.26);
  box-shadow: 0 12rpx 30rpx rgba(37, 99, 235, 0.08);
}

.risk-block-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #111827;
}

.pdf-report-action {
  margin-top: 22rpx;
}

.report-button {
  height: 76rpx;
}

.pdf-missing-text {
  display: block;
  margin-top: 16rpx;
}

.trademark-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef2f6;
}

.trademark-row:last-child {
  border-bottom: 0;
}

.trademark-title {
  display: block;
  max-width: 440rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #111827;
  word-break: break-word;
}

.suggestion-row {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
}

.suggestion-index {
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 21rpx;
  font-weight: 800;
  color: #ffffff;
  background: #3b82f6;
  flex: none;
}

.suggestion-text {
  margin-left: 16rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #334155;
}

.report-history-card {
  padding-top: 0;
  padding-bottom: 0;
}

.report-history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef2f6;
}

.report-history-main {
  flex: 1;
  min-width: 0;
}

.report-history-side {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  flex: none;
}

.report-pdf-button,
.report-pdf-missing {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.report-pdf-button {
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid rgba(37, 99, 235, 0.18);
}

.report-pdf-missing {
  color: #92400e;
  background: #fef3c7;
  border: 1rpx solid rgba(180, 83, 9, 0.18);
}

.report-delete-button {
  margin-left: 12rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(220, 38, 38, 0.18);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  color: #b91c1c;
  background: #fee2e2;
}

.menu-arrow {
  margin-left: 12rpx;
  font-size: 36rpx;
  color: #98a2b3;
}

.report-history-row:last-child {
  border-bottom: 0;
}

.report-list-action {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  border-top: 1rpx solid #eef2f6;
}

.report-list-text {
  font-size: 25rpx;
  font-weight: 800;
  color: #2563eb;
}

.report-empty {
  padding: 24rpx 0;
}
