page {
  min-height: 100vh;
}

.ai-chat-page {
  min-height: 100vh;
  padding: 22rpx 24rpx 190rpx;
  box-sizing: border-box;
}

.chat-header {
  padding: 26rpx 28rpx;
  border-radius: 16rpx;
  background:
    linear-gradient(45deg, rgba(255, 255, 255, 0.76) 0%, rgba(255, 255, 255, 0) 23%, rgba(255, 255, 255, 0) 76%, rgba(255, 255, 255, 0.58) 100%),
    radial-gradient(circle at 18% 14%, rgba(255, 255, 255, 0.86) 0%, rgba(255, 255, 255, 0) 28%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.44) 0%, rgba(248, 251, 255, 0.26) 100%),
    linear-gradient(135deg, rgba(37, 99, 235, 0.12) 0%, rgba(255, 255, 255, 0) 55%, rgba(14, 165, 233, 0.1) 100%);
  border: 1rpx double rgba(51, 65, 85, 0.16);
  box-shadow:
    inset 2rpx -2rpx 1rpx -1rpx rgba(255, 255, 255, 0.92),
    inset -2rpx 2rpx 1rpx -1rpx rgba(255, 255, 255, 0.84),
    inset 0 0 3rpx rgba(15, 23, 42, 0.28),
    0 14rpx 32rpx rgba(15, 23, 42, 0.12);
}

.chat-title {
  display: block;
  margin-top: 8rpx;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 850;
  color: #111827;
}

.chat-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #64748b;
}

.chat-messages {
  height: calc(100vh - 360rpx);
  margin-top: 22rpx;
  box-sizing: border-box;
}

.message-row {
  display: flex;
  margin-bottom: 18rpx;
}

.message-assistant {
  justify-content: flex-start;
}

.message-user {
  justify-content: flex-end;
}

.message-bubble {
  max-width: 78%;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.08);
}

.message-assistant .message-bubble {
  color: #111827;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(148, 163, 184, 0.28);
}

.message-user .message-bubble {
  color: #ffffff;
  background: #2563eb;
}

.message-text {
  display: block;
  font-size: 27rpx;
  line-height: 1.55;
  word-break: break-word;
}

.message-attachments {
  margin-top: 14rpx;
}

.message-attachment {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 10rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(15, 23, 42, 0.08);
}

.message-user .message-attachment {
  background: rgba(255, 255, 255, 0.16);
}

.attachment-type,
.pending-type {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 10rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 850;
  color: #1d4ed8;
  background: #e8f0ff;
  flex: none;
}

.attachment-name,
.pending-name {
  min-width: 0;
  margin-left: 10rpx;
  font-size: 22rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(247, 250, 255, 0.92);
  border-top: 1rpx solid rgba(148, 163, 184, 0.24);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-sizing: border-box;
}

.pending-attachments {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.pending-chip {
  display: flex;
  align-items: center;
  max-width: 320rpx;
  margin: 0 12rpx 10rpx 0;
  padding: 8rpx 10rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid rgba(148, 163, 184, 0.28);
  box-sizing: border-box;
}

.pending-remove {
  margin-left: 10rpx;
  color: #94a3b8;
  font-size: 26rpx;
}

.composer-row {
  display: flex;
  align-items: center;
  width: 100%;
}

.composer-plus,
.composer-send {
  flex: 0 0 72rpx;
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx;
  min-height: 72rpx;
  margin-left: 10rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-sizing: border-box;
}

.composer-plus::after,
.composer-send::after {
  border: 0;
}

.composer-input-wrap {
  flex: 1 1 auto;
  min-width: 0;
  min-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid rgba(148, 163, 184, 0.3);
  box-sizing: border-box;
}

.composer-input {
  width: 100%;
  min-height: 72rpx;
  max-height: 180rpx;
  padding: 18rpx 0;
  font-size: 26rpx;
  line-height: 1.4;
  color: #111827;
  background: transparent;
  box-sizing: border-box;
}

.composer-plus {
  color: #1d4ed8;
  font-size: 40rpx;
  font-weight: 850;
  background: #e8f0ff;
}

.composer-send {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 850;
  background: #2563eb;
}

.composer-action-disabled {
  opacity: 0.55;
}
