page {
  min-height: 100vh;
}

.profile-feature-page {
  padding-bottom: 72rpx;
}

.feature-hero-settings {
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 58%, #fff7ed 100%);
}

.settings-card {
  padding-top: 0;
  padding-bottom: 0;
}

.settings-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef2f6;
}

.settings-row:last-child {
  border-bottom: 0;
}

.settings-label {
  font-size: 26rpx;
  color: #111827;
  font-weight: 750;
}

.settings-value {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #64748b;
  text-align: right;
}

.menu-arrow {
  margin-left: 20rpx;
  font-size: 42rpx;
  color: #98a2b3;
}
