<view class="page-shell">
  <view class="page-content profile-feature-page">
    <view class="hero-panel feature-hero-settings">
      <text class="eyebrow">账户与偏好</text>
      <text class="hero-title">账号设置</text>
      <text class="hero-desc">在这里管理账号资料、通知偏好和安全设置。检测报告和案件提醒会按你的偏好发送。</text>
    </view>

    <view class="section">
      <text class="section-title">账号资料</text>
      <view class="card settings-card">
        <view class="settings-row" wx:for="{{accountRows}}" wx:key="label">
          <text class="settings-label">{{item.label}}</text>
          <text class="settings-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view class="section" wx:for="{{settingGroups}}" wx:key="title">
      <text class="section-title">{{item.title}}</text>
      <view class="card settings-card">
        <view class="settings-row" wx:for="{{item.items}}" wx:for-item="setting" wx:key="*this" bindtap="showPreparing">
          <text class="settings-label">{{setting}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>
  </view>
</view>
