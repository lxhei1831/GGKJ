<view class="page-shell">
  <view class="page-content appeal-template-page">
    <view class="hero-panel appeal-template-hero">
      <text class="eyebrow">平台申诉文案</text>
      <text class="hero-title">{{platform}}英文专业申诉模板</text>
      <text class="hero-desc">只需补全3项关键信息，生成一封更正式、更有说服力的英文申诉信。</text>
    </view>

    <view class="section">
      <view class="card template-form-card">
        <view class="row-between">
          <view>
            <text class="card-title">补全申诉信息</text>
            <text class="card-desc">用简短事实描述即可，系统会组织成英文专业表达。</text>
          </view>
          <text class="badge badge-info">不含链接</text>
        </view>

        <view class="field" wx:for="{{appealFields}}" wx:key="key">
          <text class="field-label">{{item.label}}</text>
          <textarea
            class="text-area template-area compact-template-area"
            placeholder="{{item.placeholder}}"
            value="{{appealForm[item.key]}}"
            data-field="{{item.key}}"
            bindinput="bindAppealInput"
            maxlength="180"
            auto-height="{{false}}"
          ></textarea>
        </view>

        <view class="primary-button template-button" bindtap="generateAppealTemplate">生成英文申诉模板</view>
      </view>
    </view>

    <view class="section" wx:if="{{generatedTemplate}}">
      <view class="card generated-template-card">
        <view class="row-between">
          <view>
            <text class="card-title">可发送英文模板</text>
            <text class="card-desc">下方为完整预览，复制后可直接发送给平台审核团队。</text>
          </view>
          <text class="badge badge-info">完整预览</text>
        </view>

        <view class="letter-preview">
          <view
            class="letter-paragraph letter-paragraph-{{item.type}}"
            wx:for="{{generatedTemplateBlocks}}"
            wx:key="id"
          >
            <text selectable="{{true}}">{{item.content}}</text>
          </view>
        </view>

        <view class="secondary-button template-button" bindtap="copyGeneratedTemplate">复制模板</view>
      </view>
    </view>
  </view>
</view>
