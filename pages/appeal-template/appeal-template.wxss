page {
  min-height: 100vh;
}

.appeal-template-page {
  padding-bottom: 72rpx;
}

.appeal-template-hero {
  background:
    linear-gradient(45deg, rgba(255, 255, 255, 0.76) 0%, rgba(255, 255, 255, 0) 23%, rgba(255, 255, 255, 0) 76%, rgba(255, 255, 255, 0.58) 100%),
    radial-gradient(circle at 18% 14%, rgba(255, 255, 255, 0.86) 0%, rgba(255, 255, 255, 0) 28%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.44) 0%, rgba(248, 251, 255, 0.26) 100%),
    linear-gradient(135deg, rgba(37, 99, 235, 0.12) 0%, rgba(255, 255, 255, 0) 55%, rgba(14, 165, 233, 0.1) 100%);
}

.template-form-card,
.generated-template-card {
  margin-top: 0;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(248, 251, 255, 0.86) 100%),
    linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(255, 255, 255, 0) 58%, rgba(14, 165, 233, 0.08) 100%);
}

.template-area {
  min-height: 82rpx;
  height: 82rpx;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  line-height: 1.45;
}

.compact-template-area {
  font-size: 25rpx;
}

.template-button {
  margin-top: 24rpx;
}

.letter-preview {
  margin-top: 26rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #e2e8f0;
}

.letter-paragraph {
  display: block;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  line-height: 1.72;
  color: #111827;
  word-break: break-word;
  white-space: pre-wrap;
}

.letter-paragraph-subject {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  font-weight: 800;
  color: #1d4ed8;
  background: rgba(37, 99, 235, 0.08);
}

.letter-paragraph-salutation {
  font-weight: 750;
}

.letter-paragraph-closing {
  margin-top: 28rpx;
  margin-bottom: 0;
  font-weight: 750;
}
