page {
  min-height: 100vh;
}

.appeal-template-page {
  padding-bottom: 72rpx;
}

.appeal-template-hero {
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 58%, #fff7ed 100%);
}

.template-form-card,
.generated-template-card {
  margin-top: 0;
  background: linear-gradient(145deg, #ffffff 0%, #f8fbff 66%, #fff7ed 100%);
}

.template-area {
  min-height: 82rpx;
  height: 82rpx;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  line-height: 1.45;
}

.compact-template-area {
  font-size: 25rpx;
}

.template-button {
  margin-top: 24rpx;
}

.letter-preview {
  margin-top: 26rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #e2e8f0;
}

.letter-paragraph {
  display: block;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  line-height: 1.72;
  color: #111827;
  word-break: break-word;
  white-space: pre-wrap;
}

.letter-paragraph-subject {
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  font-weight: 800;
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid rgba(37, 99, 235, 0.14);
}

.letter-paragraph-salutation {
  font-weight: 750;
}

.letter-paragraph-closing {
  margin-top: 28rpx;
  margin-bottom: 0;
  font-weight: 750;
}
