<view class="page-shell">
  <view class="page-content profile-feature-page">
    <view class="hero-panel feature-hero feature-hero-tro">
      <text class="eyebrow">案件应急台账</text>
      <text class="hero-title">我的TRO案件</text>
      <text class="hero-desc">暂无TRO案件。待检测后会展示案件状态、冻结金额、下一步动作和关键截止时间。</text>
    </view>

    <view class="section">
      <view class="empty-panel">
        <text class="empty-mark">案</text>
        <text class="empty-title">暂无TRO案件</text>
        <text class="empty-desc">待检测后，这里会按照平台、案件号、风险等级和律师建议形成案件跟进表。</text>
        <view class="primary-button empty-button" bindtap="goTroEmergency">进入TRO应急</view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">案件概览</text>
      <view class="grid-two">
        <view class="grid-item" wx:for="{{futureFields}}" wx:key="label">
          <view class="card feature-stat-card">
            <text class="metric-label">{{item.label}}</text>
            <text class="feature-stat-value">{{item.value}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">材料清单</text>
      <view class="card checklist-card">
        <view class="feature-list-row" wx:for="{{materialList}}" wx:key="*this">
          <text class="feature-dot"></text>
          <text class="feature-list-text">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">跟进流程</text>
      <view class="card timeline-card">
        <view class="timeline-row" wx:for="{{process}}" wx:key="title">
          <text class="timeline-node">{{index + 1}}</text>
          <view class="timeline-main">
            <text class="card-title">{{item.title}}</text>
            <text class="card-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
