page {
  min-height: 100vh;
}

.report-detail-page {
  padding-bottom: 72rpx;
}

.report-hero {
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 58%, #fff7ed 100%);
}

.result-card {
  overflow: hidden;
}

.result-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.result-score {
  display: block;
  font-size: 70rpx;
  line-height: 1;
  font-weight: 900;
  color: #3b82f6;
}

.result-level {
  text-align: right;
}

.pdf-report-action {
  margin-top: 22rpx;
}

.report-button {
  height: 76rpx;
}

.pdf-missing-text {
  display: block;
  margin-top: 16rpx;
}

.risk-block {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef2f6;
}

.risk-block:last-child {
  border-bottom: 0;
}

.risk-block-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #111827;
}

.trademark-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef2f6;
}

.trademark-row:last-child {
  border-bottom: 0;
}

.trademark-title {
  display: block;
  max-width: 440rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #111827;
  word-break: break-word;
}

.suggestion-row {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
}

.suggestion-row:first-child {
  margin-top: 0;
}

.suggestion-index {
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 21rpx;
  font-weight: 800;
  color: #ffffff;
  background: #3b82f6;
  flex: none;
}

.suggestion-text {
  margin-left: 16rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #334155;
}
