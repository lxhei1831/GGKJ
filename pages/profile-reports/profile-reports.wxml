<view class="page-shell">
  <view class="page-content profile-reports-page">
    <view class="hero-panel reports-hero">
      <text class="eyebrow">报告中心</text>
      <text class="hero-title">我的检测报告</text>
      <text class="hero-desc">查看最近检测结果、PDF报告和USPTO候选商标。</text>
    </view>

    <view class="section">
      <text class="section-title">全部检测报告</text>
      <view class="card report-list-card">
        <block wx:if="{{records.length}}">
          <view class="report-row" wx:for="{{records}}" wx:key="id" bindtap="openReportDetail" data-id="{{item.id}}">
            <view class="report-main">
              <text class="card-title">{{item.name}}</text>
              <text class="card-desc">{{item.date}} · {{item.jurisdiction}} · 风险分 {{item.score}}</text>
            </view>
            <view class="report-side">
              <text class="badge badge-{{item.level}}">{{item.levelText}}</text>
              <view class="report-delete-button" catchtap="confirmDeleteReport" data-id="{{item.id}}">删除</view>
              <text class="menu-arrow">›</text>
            </view>
          </view>
        </block>
        <view class="report-empty" wx:else>
          <text class="card-title">暂无检测报告</text>
          <text class="card-desc">完成检测后会在这里集中展示。</text>
        </view>
      </view>
    </view>
  </view>
</view>
