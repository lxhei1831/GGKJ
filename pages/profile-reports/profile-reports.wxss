page {
  min-height: 100vh;
}

.profile-reports-page {
  padding-bottom: 72rpx;
}

.reports-hero {
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 58%, #fff7ed 100%);
}

.report-list-card {
  padding-top: 0;
  padding-bottom: 0;
}

.report-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef2f6;
}

.report-row:last-child {
  border-bottom: 0;
}

.report-main {
  flex: 1;
  min-width: 0;
}

.report-side {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  flex: none;
}

.report-delete-button {
  margin-left: 12rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(220, 38, 38, 0.18);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  color: #b91c1c;
  background: #fee2e2;
}

.menu-arrow {
  margin-left: 12rpx;
  font-size: 36rpx;
  color: #98a2b3;
}

.report-empty {
  padding: 24rpx 0;
}
