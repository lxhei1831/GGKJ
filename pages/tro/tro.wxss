page {
  min-height: 100vh;
}

.tro-page {
  padding-bottom: 72rpx;
}

.tro-hero {
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 58%, #fff7ed 100%);
}

.tro-button {
  margin-top: 26rpx;
}

.case-result-card {
  margin-top: 24rpx;
}

.lawyer-service-card {
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 58%, #fff7ed 100%);
}

.lawyer-service-top {
  display: flex;
  align-items: center;
}

.lawyer-avatar {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 22rpx;
  text-align: center;
  font-size: 38rpx;
  font-weight: 900;
  color: #ffffff;
  background: linear-gradient(145deg, #3b82f6 0%, #2563eb 62%, #fb923c 100%);
  flex: none;
}

.lawyer-service-main {
  flex: 1;
  margin-left: 20rpx;
}

.menu-arrow {
  margin-left: 16rpx;
  font-size: 44rpx;
  color: #98a2b3;
}

.lawyer-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.lawyer-tag {
  margin: 0 12rpx 12rpx 0;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid rgba(37, 99, 235, 0.14);
}

.case-action {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
}

.case-action-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 13rpx;
  border-radius: 999rpx;
  background: #3b82f6;
  flex: none;
}

.case-action-text {
  margin-left: 16rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #344054;
}
