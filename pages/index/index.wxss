page {
  min-height: 100vh;
}

.risk-page {
  padding-bottom: 72rpx;
}

.hero-badge {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid rgba(37, 99, 235, 0.16);
}

.hero-metrics {
  display: flex;
  margin-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  padding-top: 24rpx;
}

.hero-metric {
  flex: 1;
}

.hero-metric-value {
  display: block;
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 850;
}

.hero-metric-label {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #64748b;
}

.quick-detect-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 172rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 58%, #fff7ed 100%);
}

.quick-detect-card:active {
  transform: scale(0.98);
}

.quick-detect-copy {
  min-width: 0;
  flex: 1;
}

.quick-detect-button {
  width: 220rpx;
  flex: none;
}

.action-mark {
  width: 52rpx;
  height: 12rpx;
  border-radius: 999rpx;
  margin-bottom: 18rpx;
  background: linear-gradient(90deg, #3b82f6 0%, #fb923c 100%);
}

.case-list {
  margin-top: 2rpx;
}

.case-card {
  margin-top: 18rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #ffffff 0%, #f8fbff 64%, #fff7ed 100%);
}

.case-card:active {
  transform: scale(0.98);
}

.case-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.case-flow {
  display: flex;
  flex-wrap: nowrap;
  margin: 18rpx -6rpx 0;
}

.case-step {
  flex: 1;
  min-width: 0;
  min-height: 40rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
}

.case-step-dot {
  width: 12rpx;
  height: 12rpx;
  margin: 12rpx 10rpx 0 0;
  border-radius: 999rpx;
  flex: none;
  background: #3b82f6;
}

.case-step-text {
  font-size: 22rpx;
  line-height: 1.35;
  color: #334155;
  white-space: nowrap;
}

.case-more {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #1d4ed8;
  font-weight: 750;
}

.case-more-arrow {
  margin-left: 8rpx;
  font-size: 30rpx;
  line-height: 1;
}
