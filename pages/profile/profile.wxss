page {
  min-height: 100vh;
}

.profile-page {
  padding-bottom: 72rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 62%, #fff7ed 100%);
  border: 1rpx solid rgba(148, 163, 184, 0.26);
  box-shadow: 0 12rpx 30rpx rgba(37, 99, 235, 0.08);
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  border-radius: 22rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 900;
  color: #ffffff;
  background: linear-gradient(145deg, #3b82f6 0%, #2563eb 62%, #fb923c 100%);
  flex: none;
}

.avatar-image {
  display: block;
  line-height: normal;
  background: #f8fafc;
}

.profile-main {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.profile-name {
  display: block;
  font-size: 32rpx;
  font-weight: 850;
  color: #101828;
}

.profile-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #667085;
}

.profile-sync-copy {
  margin-top: 4rpx;
}

.profile-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: none;
}

.profile-action-button {
  width: 108rpx;
  height: 58rpx;
  font-size: 22rpx;
}

.login-card {
  margin-top: 0;
  background: linear-gradient(145deg, #ffffff 0%, #f8fbff 64%, #fff7ed 100%);
}

.login-title,
.login-desc {
  display: block;
}

.login-desc {
  margin-top: 8rpx;
}

.login-button {
  width: 100%;
  margin-top: 26rpx;
}

.wechat-login-button::after,
.avatar-picker::after,
.contact-native-button::after {
  border: 0;
}

.login-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  border: 1rpx solid #dbe5f0;
  font-size: 28rpx;
  font-weight: 700;
  color: #101828;
}

.login-error {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #dc2626;
}

.summary-card {
  min-height: 152rpx;
  margin-top: 0;
  background: linear-gradient(145deg, #ffffff 0%, #f8fbff 66%, #fff7ed 100%);
}

.menu-card {
  padding-top: 0;
  padding-bottom: 0;
}

.menu-row,
.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef2f6;
}

.menu-mark {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 18rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 850;
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid #dbeafe;
  flex: none;
}

.menu-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.menu-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.menu-title-row .badge {
  margin-left: 14rpx;
  flex: none;
}

.menu-row:last-child,
.record-row:last-child {
  border-bottom: 0;
}

.menu-arrow {
  margin-left: 20rpx;
  font-size: 42rpx;
  color: #98a2b3;
}

.contact-card {
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 58%, #fff7ed 100%);
}

.contact-button {
  margin-top: 22rpx;
}

.contact-native-button {
  width: 100%;
  padding: 0;
  border: 0;
  line-height: normal;
}

.profile-editor-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.38);
}

.profile-editor-sheet {
  box-sizing: border-box;
  width: 100%;
  padding: 34rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 80rpx rgba(15, 23, 42, 0.18);
}

.sheet-title,
.sheet-desc {
  display: block;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #101828;
}

.sheet-desc {
  margin-top: 8rpx;
}

.avatar-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  margin: 30rpx auto 24rpx;
  padding: 0;
  border-radius: 30rpx;
  background: #eff6ff;
  border: 1rpx solid #dbeafe;
}

.avatar-preview {
  display: block;
  width: 132rpx;
  height: 132rpx;
  border-radius: 30rpx;
}

.avatar-placeholder {
  font-size: 24rpx;
  font-weight: 800;
  color: #2563eb;
}

.nickname-input {
  margin-top: 0;
}

.sheet-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.sheet-cancel,
.sheet-confirm {
  flex: 1;
  min-width: 0;
}
