page {
  min-height: 100vh;
}

.profile-page {
  padding-bottom: 72rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 62%, #fff7ed 100%);
  border: 1rpx solid rgba(148, 163, 184, 0.26);
  box-shadow: 0 12rpx 30rpx rgba(37, 99, 235, 0.08);
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  border-radius: 22rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 900;
  color: #ffffff;
  background: linear-gradient(145deg, #3b82f6 0%, #2563eb 62%, #fb923c 100%);
  flex: none;
}

.profile-main {
  flex: 1;
  margin-left: 22rpx;
}

.profile-name {
  display: block;
  font-size: 32rpx;
  font-weight: 850;
  color: #101828;
}

.profile-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #667085;
}

.renew-button {
  width: 128rpx;
  height: 66rpx;
  font-size: 24rpx;
  flex: none;
}

.summary-card {
  min-height: 152rpx;
  margin-top: 0;
  background: linear-gradient(145deg, #ffffff 0%, #f8fbff 66%, #fff7ed 100%);
}

.menu-card {
  padding-top: 0;
  padding-bottom: 0;
}

.menu-row,
.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef2f6;
}

.menu-mark {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 18rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 850;
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid #dbeafe;
  flex: none;
}

.menu-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.menu-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.menu-title-row .badge {
  margin-left: 14rpx;
  flex: none;
}

.menu-row:last-child,
.record-row:last-child {
  border-bottom: 0;
}

.menu-arrow {
  margin-left: 20rpx;
  font-size: 42rpx;
  color: #98a2b3;
}

.contact-card {
  background: linear-gradient(145deg, #ffffff 0%, #f3f9ff 58%, #fff7ed 100%);
}

.contact-button {
  margin-top: 22rpx;
}

.contact-native-button {
  width: 100%;
  padding: 0;
  border: 0;
  line-height: normal;
}

.contact-native-button::after {
  border: 0;
}
